# ===== 数据库部署模式 (支持交互式选择，定时任务自动记忆免交互) =====
# DB_MODE 可选值:
#   dedicated: 独立专属 PostgreSQL 容器 (${APP_NAME}-pg，默认复用本地 PG 镜像)
#   shared:    共享宿主机已在运行的 PG 容器 (如 pgvector-18，自动创建专属库与账号，零多余容器)
#   sqlite:    本地化单文件 SQLite (挂载 ./data/db.sqlite3，整站常驻约 50MB 内存)
DB_MODE=dedicated
APP_NAME=mengya
SHARED_PG_CONTAINER=pgvector-18
COMPOSE_FILE=docker-compose.yml:docker-compose.db.yml

# ===== 数据库连接配置 =====
DATABASE_URL=postgresql://mengya:mengya123@db:5432/mengya
DB_IMAGE=pgvector/pgvector:pg18
DB_PULL_POLICY=never

# ===== Django =====
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,*

# ===== Database / Redis (compose 内置默认值，可直接使用) =====
DATABASE_URL=postgresql://mengya:mengya123@db:5432/mengya
REDIS_URL=redis://redis:6379/0

# ===== JWT =====
JWT_SECRET_KEY=change-me-in-production

# ===== AI (可选，不配置则使用内置本地回复引擎) =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ===== 电商 CPS（预留，暂不影响运行）=====
TAOBAO_APP_KEY=
JD_APP_KEY=
PDD_APP_KEY=

# ===== Celery =====
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
