# ===== 数据库部署模式 (支持交互式选择，定时任务自动采用最佳交互) =====
# DB_MODE 候选值:
#   dedicated: 独立专属 PostgreSQL 容器 (${APP_NAME}-pg，默认复用本地 PG 镜像)
#   shared:    共享宿主机运行中的 PG 容器 (如 pgvector-18，自动创建专属账号与数据库，零多余容器)
#   sqlite:    本地化单文件 SQLite (挂载 ./data/db.sqlite3，整站常驻约 50MB 内存)
DB_MODE=dedicated
APP_NAME=mengya_docker
# 共享 PG 容器名称（在 shared 模式使用，留空则由探针自动扫描宿主机运行中的 PG 容器）
# SHARED_PG_CONTAINER=
COMPOSE_FILE=docker-compose.yml:docker-compose.db.yml

# ===== 数据库与存储配置 (与传统版 mengya_local 深度数据隔离) =====
POSTGRES_USER=mengya_docker
POSTGRES_PASSWORD=mengya_docker123
POSTGRES_DB=mengya_docker
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mengya_docker:mengya_docker123@db:5432/mengya_docker
# PG 镜像配置（为空时优先复用本地现存镜像，没有才自动下载默认镜像 postgres:15-alpine）
# 用户可自定义指定其他版本，如: postgres:15-alpine, postgres:16, pgvector/pgvector:pg18
# DB_IMAGE=
DB_PULL_POLICY=never
DB_DATA_DIR=/var/lib/postgresql/data

# ===== Django =====
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,*

# ===== Database / Redis (compose 环境默认值，可直接使用) =====
REDIS_URL=redis://redis:6379/0

# ===== JWT =====
JWT_SECRET_KEY=change-me-in-production

# ===== AI (可选配置，未配置时使用内置本地回复引擎) =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ===== 电商 CPS（预留数据不影响运行）=====
TAOBAO_APP_KEY=
JD_APP_KEY=
PDD_APP_KEY=

# ===== Celery =====
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
